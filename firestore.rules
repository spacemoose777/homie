rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function userHouseholdId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId;
    }

    function isMember(hid) {
      return isAuth() && userHouseholdId() == hid;
    }

    function isAdmin(hid) {
      return isMember(hid) &&
        get(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid)).data.role == 'admin';
    }

    function isSelf(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ── /users/{uid} ──
    match /users/{uid} {
      allow read: if isAuth() && request.auth.uid == uid;
      allow create: if isAuth() && request.auth.uid == uid;
      allow update: if isAuth() && request.auth.uid == uid;
    }

    // ── /households/{hid} ──
    match /households/{hid} {
      allow read: if isMember(hid);
      allow create: if isAuth();
      allow update: if isAdmin(hid);

      // ── /households/{hid}/members/{uid} ──
      match /members/{uid} {
        allow read: if isMember(hid);
        allow update: if isMember(hid) && request.auth.uid == uid;
        allow create: if isAuth() && (request.auth.uid == uid || isAdmin(hid));
        allow delete: if isAdmin(hid);
      }

      // ── /households/{hid}/invites/{token} ──
      match /invites/{token} {
        allow read: if true;
        allow create: if isAdmin(hid);
        allow update: if isAuth();
        allow delete: if isAdmin(hid);
      }

      // ── /households/{hid}/shoppingItems/{id} ──
      match /shoppingItems/{id} {
        allow read, write: if isMember(hid);
      }

      // ── /households/{hid}/itemMemory/{name} ──
      match /itemMemory/{name} {
        allow read, write: if isMember(hid);
      }

      // ── /households/{hid}/meals/{id} ──
      match /meals/{id} {
        allow read, write: if isMember(hid);
      }

      // ── /households/{hid}/weekPlans/{weekDate} ──
      match /weekPlans/{weekDate} {
        allow read, write: if isMember(hid);
      }

      // ── /households/{hid}/calendarEvents/{id} ──
      match /calendarEvents/{id} {
        allow read, write: if isMember(hid);
      }

      // ── /households/{hid}/stores/{storeId} ──
      match /stores/{storeId} {
        allow read: if isMember(hid);
        allow create, update, delete: if isAdmin(hid);
      }

      // ── /households/{hid}/customLists/{listId} ──
      match /customLists/{listId} {
        allow read, write: if isMember(hid);

        // ── /households/{hid}/customLists/{listId}/items/{itemId} ──
        match /items/{itemId} {
          allow read, write: if isMember(hid);
        }
      }

      // ── /households/{hid}/meetings/{meetingId} ──
      match /meetings/{meetingId} {
        allow read, write: if isMember(hid); // hui-whanau
      }

      // ── /households/{hid}/whanauTasks/{id} ──
      match /whanauTasks/{id} {
        allow read, write: if isMember(hid);
      }

      // ── /households/{hid}/choreLists/{listId} ──
      match /choreLists/{listId} {
        allow read: if isMember(hid);
        allow create, update: if isAdmin(hid);
        // No delete — retire a checklist via `active: false` instead, so its
        // past weeks (nested below) are never orphaned.

        // ── /households/{hid}/choreLists/{listId}/weeks/{weekId} ──
        match /weeks/{weekId} {
          allow read: if isMember(hid);

          // A parent can start any week. The assignee (e.g. Sam) can only
          // create their OWN week, in the starting state — never pre-approved.
          allow create: if isMember(hid)
            && request.resource.data.assigneeUid ==
               get(/databases/$(database)/documents/households/$(hid)/choreLists/$(listId)).data.assigneeUid
            && (isAdmin(hid) || isSelf(request.resource.data.assigneeUid))
            && request.resource.data.status == 'in_progress'
            && request.resource.data.awardedAmount == null
            && request.resource.data.approvedAt == null
            && request.resource.data.approvedBy == null;

          // A parent can change anything (approve, adjust the amount, send a
          // task back for redo, etc). The assignee can only tick tasks and
          // submit their own week — the allowed-fields check below means
          // they have no path to approve it, change the amount, or touch
          // anyone else's week.
          allow update: if isAdmin(hid)
            || (
              isSelf(resource.data.assigneeUid)
              && resource.data.status in ['in_progress', 'redo']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rooms', 'status', 'submittedAt'])
              && request.resource.data.status in ['in_progress', 'submitted']
            );

          allow delete: if isAdmin(hid);
        }
      }

      // ── /households/{hid}/choreJobs/{jobId} ──
      match /choreJobs/{jobId} {
        allow read: if isMember(hid);
        allow create, delete: if isAdmin(hid);

        // A parent can change anything (approve, adjust the amount, send
        // back, etc). The assignee can only flip their OWN open job to
        // "done" — nothing else, same allowed-fields pattern as choreWeeks.
        allow update: if isAdmin(hid)
          || (
            isSelf(resource.data.assigneeUid)
            && resource.data.status == 'open'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'doneAt'])
            && request.resource.data.status == 'done'
          );
      }

      // ── /households/{hid}/ledger/{entryId} ──
      // The money trail. Balance is always the live sum of these, never a
      // stored number — so there is nothing to protect except the entries
      // themselves, and only a parent may ever write one.
      match /ledger/{entryId} {
        allow read: if isAdmin(hid) || isSelf(resource.data.memberUid);
        allow create, update, delete: if isAdmin(hid);
      }
    }

    // Allow collectionGroup queries on "invites" (needed by findInviteByToken)
    match /{path=**}/invites/{token} {
      allow read: if true;
    }
  }
}
